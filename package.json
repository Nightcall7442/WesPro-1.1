{
  "name": "billiards-club",
  "version": "1.15.0",
  "description": "Система управления бильярдным клубом: столы, тарифы, сеансы, живой таймер",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node -e \"require('fs').closeSync(require('fs').openSync('.env','a'))\" && node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "add-user": "node src/cli/add-user.js",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@tuya/tuya-connector-nodejs": "^2.1.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6"
  }
}
