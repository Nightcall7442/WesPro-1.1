# Скопируйте в .env и заполните. Файл .env подхватывается автоматически
# при npm run dev / npm start и в git не попадает.

# Включить реальные реле Tuya/MOES (по умолчанию mock):
# BILLIARDS_LIGHTING=tuya

# Ключи облачного проекта с https://iot.tuya.com (Cloud -> ваш проект -> Overview):
# TUYA_ACCESS_ID=xxxxxxxxxxxxxxxxxxxx
# TUYA_ACCESS_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Дата-центр аккаунта Smart Life (Россия/Европа — Central Europe):
# TUYA_API_HOST=https://openapi.tuyaeu.com

# Порт веб-интерфейса (по умолчанию 8000):
# PORT=8000
